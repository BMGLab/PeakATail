/*
 * Nextflow config for the FILTER-EFFECT experiment.
 * Target: single BioLab node (112 cores). Local executor. 4 scenarios x
 * ~6-GSM subset each, far smaller than the corrected-rerun 17-GSM cohort,
 * so a modest core budget keeps the box usable for the RERUN sweep / hub too.
 */

params.exp_root        = params.exp_root ?: '/mnt/ssd2/Laugney_Aligned/peakatail_experiments/FILTER_EFFECT_2026-08'
params.threads_per_run = 16

env {
    PEAKATAIL_NO_TIMESTAMP = '1'
    OMP_NUM_THREADS        = '1'
    OPENBLAS_NUM_THREADS   = '1'
    MKL_NUM_THREADS        = '1'
    TMPDIR                 = '/mnt/ssd2/Laugney_Aligned/rt'
    XDG_CACHE_HOME         = "${params.exp_root}/cache"
    XDG_CONFIG_HOME        = "${params.exp_root}/config"
    MPLCONFIGDIR            = "${params.exp_root}/cache/mpl"
    NUMBA_CACHE_DIR         = "${params.exp_root}/cache/numba"
}

profiles {
    biolab {
        process.executor = 'local'
        executor {
            queueSize = 100
        }
        // 4 scenarios x lambda_gradient subset run (16 threads each) can run
        // 2 at a time (32 cores) without starving the RERUN sweep / hub if
        // those are active; switch stages fan out per-celltype after.
        executor.$local.cpus   = 64
        executor.$local.memory = '400 GB'

        process {
            scratch = false
            errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
            maxRetries = 1

            withName: 'PREWARM_GTF'      { cpus = 4;  maxForks = 1
                                           errorStrategy = { task.attempt <= 1 ? 'retry' : 'terminate' } }
            withName: 'BUILD_3UTR_BED'   { cpus = 2;  maxForks = 1
                                           errorStrategy = { task.attempt <= 1 ? 'retry' : 'terminate' } }
            withName: 'RUN_SCENARIO'     { cpus = params.threads_per_run; maxForks = 2 }
            withName: 'GEX_CELLTYPE'     { cpus = 16; maxForks = 2 }
            withName: 'SWITCH_COMBINE'   { cpus = 8;  maxForks = 2 }
            withName: 'SWITCH_CELLTYPE'  { cpus = 6;  maxForks = 8 }
        }
    }
}

timeline.enabled = true
report.enabled   = true
trace.enabled    = true
dag.enabled      = true
timeline.file = "${params.exp_root}/logs/timeline.html"
report.file   = "${params.exp_root}/logs/report.html"
trace.file    = "${params.exp_root}/logs/trace.txt"
dag.file      = "${params.exp_root}/logs/dag.html"
timeline.overwrite = true
report.overwrite   = true
trace.overwrite    = true
dag.overwrite      = true
