# Author list matches the PeakATail manuscript (Amiri Tabat & Kaymaz).
# Further authors will be added as the manuscript's author list grows; keep
# the order here identical to the paper's.
cff-version: 1.2.0
message: "If you use PeakATail in your research, please cite it using the metadata below."
type: software
title: "PeakATail"
version: "0.3.1"
abstract: "Single-cell poly(A) site detection and alternative polyadenylation (APA) analysis from scRNA-seq BAM files."
authors:
  - family-names: "Amiri Tabat"
    given-names: "Amir"
    orcid: "https://orcid.org/0009-0009-8740-7770"
    affiliation: "Department of Computer Engineering, Faculty of Computer and Informatics Sciences, Ege University, İzmir, Türkiye"
  - family-names: "Kaymaz"
